layout {

    focus-ring {
        active-color   "#ffafd5"
        inactive-color "#000000"
        urgent-color   "#ffb4ab"
    }

    border {
        active-color   "#ffafd5"
        inactive-color "#000000"
        urgent-color   "#ffb4ab"
    }


    tab-indicator {
        active-color   "#ffafd5"
        inactive-color "#782956"
        urgent-color   "#ffb4ab"
    }

    insert-hint {
        color "#ffafd580"
    }
}

recent-windows {
    highlight {
        active-color "#ffafd5"
        urgent-color "#ffb4ab"
    }
}
